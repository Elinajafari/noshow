# studionet (default, gasless) | testnet-asimov
GENLAYER_NETWORK=studionet

# On studionet, empty keys mean a fresh wallet per role for every run, and the
# client is funded from the StudioNet faucet. On a funded network all are
# required, and the client must hold the fees. Never commit real keys.
DEPLOYER_PRIVATE_KEY=
CLIENT_PRIVATE_KEY=
ANN_PRIVATE_KEY=
BEN_PRIVATE_KEY=
CAL_PRIVATE_KEY=
DEV_PRIVATE_KEY=
STRANGER_PRIVATE_KEY=
